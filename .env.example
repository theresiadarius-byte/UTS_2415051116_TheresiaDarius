# Salin file ini menjadi .env lalu isi dengan nilai asli dari Supabase dashboard.
# JANGAN commit file .env ke repository!

# Supabase Project URL (dari: Settings > API > Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (dari: Settings > API > Project API Keys > anon public)
SUPABASE_KEY=your-anon-key-here
